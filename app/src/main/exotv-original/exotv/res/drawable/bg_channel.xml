<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/live_focus_start" android:endColor="@color/live_focus_end" android:angle="315.0" android:type="linear" />
            <corners android:radius="18.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="18.0dip" />
            <stroke android:width="1.0dip" android:color="@color/card_stroke" />
        </shape>
    </item>
</selector>